{
  // Cloudflare Workers configuration for the OpenNext build (`.open-next/`).
  // Deployed with `npm run cf:deploy`; previewed locally with `npm run cf:preview`.
  // See docs/setup-cloudflare.md and https://opennext.js.org/cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-convert",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-14",
  "compatibility_flags": [
    // Expose Node.js APIs to the app (required by OpenNext).
    "nodejs_compat",
    // Require fetch() URLs to be full, public URLs (OpenNext recommendation).
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // By default `wrangler deploy` DELETES dashboard-set variables and secrets
  // that are not declared in this file. The Apify fallback (APIFY_TOKEN and
  // friends, see docs/apify-provider.md) is configured in the Cloudflare
  // dashboard rather than here, so deploys from the GitHub workflow must
  // keep them instead of silently wiping the operator's configuration.
  "keep_vars": true,
  "services": [
    {
      // Self-reference so OpenNext's cache can re-enter this Worker. The
      // service name must match the worker "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yt-convert"
    }
  ],
  // Plain-text (non-secret) runtime vars. Declaring a var here makes wrangler
  // the owner of it, which is what keeps the deploy workflow green: a name that
  // exists as a dashboard *Text var* cannot also be written by
  // `wrangler secret put` (Cloudflare answers "Binding name 'X' already in
  // use [code 10053]"), so anything non-sensitive belongs here instead of in
  // the secrets loop. To change the FAQ assistant's model, edit this value and
  // let the next deploy apply it.
  "vars": {
    // Matches the in-code default in src/app/api/faq-assistant/route.ts and
    // .env.example. A model name is not a credential — there is no reason for
    // it to be an encrypted secret.
    "OPENAI_MODEL": "gpt-4o-mini"
  }
  // Runtime secrets (CAPTCHA_SECRET, CONVERT_TICKET_SECRET, ADMIN_TOKEN, …)
  // are NOT listed here: they go in .dev.vars for local preview and are
  // uploaded as encrypted secrets by the deploy workflow. Build-time
  // NEXT_PUBLIC_* values are inlined during `npm run cf:build`, so they are
  // supplied in the build environment instead.
  //
  // The Turnstile *site key* (NEXT_PUBLIC_TURNSTILE_SITE_KEY) is deliberately
  // not a runtime var either — it is inlined into the web bundle at build time,
  // and the server only needs TURNSTILE_SECRET_KEY to verify tokens. See
  // docs/setup-cloudflare.md → "Troubleshooting: … (loop)", cause 5.
}
