# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/po-token-server/node_modules
/android-app/node_modules
/.pnp
.pnp.js

# testing
/coverage
__pycache__/

# generated release notes
/android-release-notes.md

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# cloudflare workers (OpenNext adapter — see docs/setup-cloudflare.md)
.dev.vars
.open-next/
.wrangler/
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Cobalt API key file (contains a live credential; keys.example.json is the template)
/keys.json

# Android companion (android-app/): build output. The Capacitor native project
# itself IS committed; only generated artifacts are ignored.
/android-app/dist
/android-app/android/app/src/main/assets/public
/android-app/android/app/src/main/assets/capacitor.config.json
/android-app/android/app/src/main/assets/capacitor.plugins.json
/android-app/android/app/src/main/res/xml/config.xml
/android-app/android/.gradle
/android-app/android/build
/android-app/android/app/build
/android-app/android/capacitor-cordova-android-plugins
/android-app/android/local.properties
*.apk
*.aab

# Android signing material must never be committed
*.jks
*.keystore
keystore.properties
