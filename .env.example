# Canonical URL used in metadata, robots.txt, and sitemap.xml.
# Set this to your PRODUCTION custom domain, e.g. https://yt-convert.example.com
# (Vercel: Project Settings > Domains, then set this variable for the
# Production environment). You can set a different value for Preview
# deployments so previews get correct canonical URLs too.
NEXT_PUBLIC_SITE_URL=https://yt-convert.example.com

# ---------------------------------------------------------------------------
# CAPTCHA keys — separate keys per environment (production / preview / dev)
# ---------------------------------------------------------------------------
# Every provider below supports scoped keys. The scope is detected
# automatically:
#   VERCEL_ENV=production  ->  *_PROD    (Vercel production)
#   VERCEL_ENV=preview     ->  *_PREVIEW (Vercel preview deployments)
#   local `npm run dev`    ->  *_DEV
#   self-hosted prod build ->  *_PROD    (NODE_ENV=production, no VERCEL_ENV)
#
# Scoped values win over the plain variable, which remains the legacy
# fallback — so existing single-key setups keep working unchanged.
#
# In Vercel, set *_PROD / *_PREVIEW / *_DEV variables in the project's
# Environment Variables tab (the scope is picked up automatically because
# VERCEL_ENV is present at build AND runtime). For local development, put
# the *_DEV values in .env.local.

# Cloudflare Turnstile (recommended for production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY_PROD=
NEXT_PUBLIC_TURNSTILE_SITE_KEY_PREVIEW=
NEXT_PUBLIC_TURNSTILE_SITE_KEY_DEV=
TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET_KEY_PROD=
TURNSTILE_SECRET_KEY_PREVIEW=
TURNSTILE_SECRET_KEY_DEV=

# Google reCAPTCHA v2 (optional fallback / alternative)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_PROD=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_PREVIEW=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_DEV=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SECRET_KEY_PROD=
RECAPTCHA_SECRET_KEY_PREVIEW=
RECAPTCHA_SECRET_KEY_DEV=

# hCaptcha (optional fallback / alternative)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY_PROD=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY_PREVIEW=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY_DEV=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SECRET_KEY_PROD=
HCAPTCHA_SECRET_KEY_PREVIEW=
HCAPTCHA_SECRET_KEY_DEV=

# Stable server-side secret for local CAPTCHA proof tokens
CAPTCHA_SECRET=replace-with-a-long-random-value

# HMAC secret for short-lived convert tickets issued after a CAPTCHA lookup.
# Falls back to CAPTCHA_SECRET when unset.
CONVERT_TICKET_SECRET=replace-with-a-long-random-value

# ---------------------------------------------------------------------------
# Shared rate limiting (optional — Upstash Redis REST)
# ---------------------------------------------------------------------------
# Set BOTH variables on multi-instance deployments such as Vercel to share
# fixed-window counters across instances. With either variable missing, the
# app uses its existing bounded in-memory limiter (no service needed for local
# dev, CI, or self-hosting). Redis failures and calls slower than 500 ms fail
# open, so this optional abuse guard cannot make the site unavailable.
# Create a Redis database in Upstash and copy its REST API credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client-IP headers are trusted only behind a known ingress. Render and Vercel
# are detected automatically. The included Caddy stack sets this in
# docker-compose.yml after overwriting X-Forwarded-For; custom self-hosters may
# set one of: x-forwarded-for, x-real-ip, cf-connecting-ip. Never set it unless
# that proxy overwrites visitor-supplied values and the app is not reachable
# around the proxy.
TRUSTED_PROXY_IP_HEADER=

# ---------------------------------------------------------------------------
# Privacy-friendly analytics & status dashboard
# ---------------------------------------------------------------------------
# Set a strong random value (at least 16 chars) to unlock the admin
# dashboard at /status (and its API /api/status). The dashboard shows
# aggregate platform success/failure rates, bucketed errors, converter
# availability, and user reports. Without this variable the dashboard is
# disabled and returns 404. Never commit the real value.
ADMIN_TOKEN=

# Set to "1" to disable the cookieless aggregate counters entirely.
DISABLE_ANALYTICS=

# ---------------------------------------------------------------------------
# YouTube session cookie passthrough (age-gate bypass, opt-in)
# ---------------------------------------------------------------------------
# When set to "1", the UI shows an "Advanced" section on the result card for
# YouTube / YT Music videos where users can paste their own YouTube session
# cookies. The cookies are forwarded (never logged or cached) to YouTube's
# Innertube player endpoint so age-restricted / login-required videos can be
# fetched under the user's own signed-in session.
#
# SECURITY: This is a client-driven, per-request passthrough only. The server
# does NOT store, log, or share these cookies. No PO-token emulation or
# server-side login is performed. Leave OFF in production unless you have
# reviewed the privacy implications and want to offer this to power users.
NEXT_PUBLIC_YT_COOKIES_ENABLED=

# ---------------------------------------------------------------------------
# YouTube Piped fallback (tertiary extraction path)
# ---------------------------------------------------------------------------
# When every Innertube client and every Invidious instance comes up empty,
# the server tries a list of public Piped instances. Piped runs
# NewPipeExtractor server-side (where maintainers keep up with PO tokens /
# BotGuard), so it is the most reliable fallback for music-label videos.
#
# Stream URLs come back on each instance's own proxy host (e.g.
# pipedproxy-bom.kavin.rocks). The well-known public proxies are allowlisted
# by default. To allow a SELF-HOSTED Piped proxy in addition, list its host
# suffix here, comma-separated (e.g. "pipedproxy.example.com").
PIPED_PROXY_HOSTS=

# ---------------------------------------------------------------------------
# External PO-token server (optional, music-label / BotGuard bypass)
# ---------------------------------------------------------------------------
# The main app NEVER generates YouTube PO tokens itself (no BotGuard VM
# emulation). Instead an operator can run the sidecar in po-token-server/
# (Docker recommended) and point this app at it. The sidecar, this website's
# YouTube requests, and googlevideo MUST share one public egress IP; a remote
# phone/VPS sidecar plus a Vercel website does not count. When BOTH variables
# below are set, a token is fetched before Innertube player requests and
# attached under serviceIntegrityDimensions. If either is missing — or the
# server is unreachable — extraction continues normally without a token.
#
# Prefer the private root-Compose URL. If exposed over a network, use HTTPS.
# The bearer token must match AUTH_TOKEN. See po-token-server/README.md.
PO_TOKEN_SERVER_URL=
PO_TOKEN_SERVER_AUTH=

# Optional HTTP proxy used ONLY for YouTube / googlevideo / BotGuard.
# Required for the free Android same-egress path (Termux tinyproxy).
# Example: http://172.17.0.1:8888   See docs/android-egress.md
YT_EGRESS_PROXY=

# Shared secret for docker compose (sidecar AUTH_TOKEN == PO_TOKEN_SERVER_AUTH).
# Required when using the root docker-compose.yml.
AUTH_TOKEN=
SITE_ADDRESS=localhost
CADDY_EMAIL=admin@example.com

# Public hostname for the self-hosted cobalt container (root docker-compose).
# Must be a real subdomain pointing at this server, e.g. cobalt.example.com,
# because cobalt builds its tunnel URLs from it and the convert proxy only
# accepts HTTPS media URLs. Leave as-is if you are not running cobalt.
COBALT_SITE_ADDRESS=cobalt.localhost

# ---------------------------------------------------------------------------
# Cobalt API fallback (optional, LAST resort after Innertube/mirrors/9Convert)
# ---------------------------------------------------------------------------
# Cobalt returns a finished, muxed file instead of a format list. This app
# talks to the cobalt v11 API: POST / on the instance ROOT (the pre-v10
# /api/json path was shut down in Nov 2024 and no longer exists).
#
# IMPORTANT: the official api.cobalt.tools instance is BLOCKED from YouTube
# and its bot protection makes it off-limits to third-party apps, so pointing
# at it will NOT give you a working YouTube fallback — the cobalt docs tell
# operators to self-host. Leave unset to disable this fallback entirely.
COBALT_API_URL=

# Optional API token for the instance. Accepts a bare token (sent as
# "Bearer <token>") or an explicit scheme, e.g. "Api-Key aaaa-bbbb".
COBALT_API_AUTH=

# Cobalt serves tunnel/redirect URLs from its own host, so the exact host in
# COBALT_API_URL is trusted automatically. Only set this when your instance
# serves MEDIA from a different hostname; comma-separated host suffixes
# (e.g. "media.cobalt.example.com"), or those URLs are refused by the proxy.
COBALT_PROXY_HOSTS=

# Public cobalt discovery. When enabled (the default), and after the private
# instance above has been tried, the app asks cobalt.directory which APIs are
# currently passing its YouTube test and tries up to three that are on the
# committed reviewed-host allowlist (src/lib/cobalt-directory.ts). The
# directory can only narrow that allowlist, never widen it.
#
# NOTE: every public instance passing the YouTube test today also requires a
# Cloudflare Turnstile challenge, so server-to-server calls usually come back
# "error.api.auth.turnstile.missing". Set to 0 to skip discovery entirely.
COBALT_PUBLIC_DISCOVERY=1

# Optional override for the public (non-secret) Innertube API key used by the
# WEB_EMBEDDED_PLAYER client. A default well-known key is built in; only set
# this if YouTube rotates it and you need to override before a code update.
YT_API_KEY=

# ---------------------------------------------------------------------------
# Adaptive MP4 remux (ffmpeg) — docs/hd-muxing-proposal.md
# ---------------------------------------------------------------------------
# YouTube's >360p video is split into separate video + audio tracks. When
# ffmpeg is available the server stream-copies them together into an MP4 on
# the fly (no re-encode, no file stored). The Docker image bundles ffmpeg;
# set an explicit path here only to override it, or leave empty to use
# whatever `ffmpeg` is on PATH. On hosts without ffmpeg (e.g. Vercel) the
# download falls back to the single progressive file automatically.
FFMPEG_PATH=
# Force the remux off even when ffmpeg is present (1 = disabled).
DISABLE_MUXING=

# ---------------------------------------------------------------------------
# FAQ AI Assistant (Groq / OpenAI / Anthropic – optional, privacy-friendly)
# ---------------------------------------------------------------------------
# The FAQ assistant works fully offline with local knowledge (no key needed).
# If you want more natural LLM phrasing, set one of these:
# Groq (recommended – fast, cheap, OpenAI-compatible)
GROQ_API_KEY=
# e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway/proxy instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
