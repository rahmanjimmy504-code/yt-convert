# Required: shared secret the main app sends as `Authorization: Bearer <value>`.
# Use a long random value, e.g.  openssl rand -hex 32
AUTH_TOKEN=replace-with-a-long-random-value

# Port the sidecar listens on (inside the container).
PORT=4416

# How long a minted token is reused before a fresh one is generated.
# 30 minutes is a good balance; tokens usually remain valid far longer.
TOKEN_TTL_MS=1800000
