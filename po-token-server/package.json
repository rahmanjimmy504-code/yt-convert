    "dev": "node --watch server.js",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "dependencies": {
    "bgutils-js": "^3.2.0",
    "jsdom": "^26.0.0",
    "undici": "^7.29.0",
    "youtubei.js": "^13.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
